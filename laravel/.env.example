APP_NAME="BiH Patient Verification"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Reverse proxies whose X-Forwarded-For chain Laravel will trust, as a
# comma-separated list of IPs/CIDRs. MUST be pinned to Nginx Proxy Manager's
# address/subnet in production — an over-broad value (or the old '*') lets a
# client forge X-Forwarded-For to spoof the hospital IP gate and audit-log IP.
# Default 172.16.0.0/12 covers common Docker bridge ranges; confirm against
# `docker network inspect proxy-net` for your deployment.
TRUSTED_PROXIES=172.16.0.0/12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bih_db
DB_USERNAME=root
DB_PASSWORD=

# Python OpenCV microservice
PYTHON_SERVICE_URL=http://127.0.0.1:5001
PYTHON_SERVICE_API_KEY=
GEOFENCE_FAIL_OPEN=true

# Fingerprint accept/reject threshold — SINGLE SOURCE OF TRUTH.
# Must match FINGERPRINT_MATCH_THRESHOLD in python-service/.env.
# Set from tools/calibrate_far_frr.py (EER or threshold at your target FAR).
FINGERPRINT_MATCH_THRESHOLD=32.0

# Contactless four-finger (hand) embedding accept threshold — fused score,
# calibrated via tools/ridgebase_eval.py (EER 8.85% at 57.5). If unset, the
# hand tier degrades to advisory-only (needs_review, never auto-accepts) —
# do not deploy without this set.
FINGERPRINT_CONTACTLESS_MATCH_THRESHOLD=57.5

# Sanctum token TTL is set in AuthController (8 hours)
SANCTUM_STATEFUL_DOMAINS=localhost

LOG_CHANNEL=stack
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
