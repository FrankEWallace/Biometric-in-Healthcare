# Python biometric microservice — example configuration.
# Copy to `.env` and set real values. NEVER commit the real .env.

# Required in production — biometric endpoints are UNAUTHENTICATED if blank.
# Must match PYTHON_SERVICE_API_KEY in laravel/.env.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# production disables the interactive API docs (/docs, /redoc); development
# enables them. The deployed stack also forces this via docker-compose.yml.
ENVIRONMENT=production

# ── Fingerprint / hand matcher ──────────────────────────────────────────────
# Contactless four-finger embedding matcher selection.
FINGERPRINT_MATCHER=ridgeformer_embedding
# Single-finger minutiae accept/reject threshold. Keep in sync with
# FINGERPRINT_MATCH_THRESHOLD in laravel/.env.
FINGERPRINT_MATCH_THRESHOLD=32.0
# Optional: override the ONNX contactless embedding model path.
# EMBEDDING_MODEL_PATH=models/contactless_embedding.onnx

# ── FAISS ───────────────────────────────────────────────────────────────────
# Directory where the face FAISS index is persisted.
FAISS_INDEX_DIR=./face_index

# ── Passive liveness tuning (defaults shown; leave unset unless calibrating) ─
# LIVENESS_SKIN_MIN_RATIO=0.08
# LIVENESS_MOIRE_THRESHOLD=25.0
# LIVENESS_HIGHLIGHT_MIN=0.001
# LIVENESS_HIGHLIGHT_MAX=0.12
# LIVENESS_FLOW_LIVE_MIN=0.15
